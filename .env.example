APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments / Subscriptions
PAYMENT_GATEWAY=simulated
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CHECKOUT_URL=

# Stripe (paid subscription plans checkout). This backend is API-only: STRIPE_CHECKOUT_SUCCESS_URL
# and STRIPE_CHECKOUT_CANCEL_URL must be pages on the separate frontend app (not this Laravel app) -
# Stripe redirects the user's browser there after checkout, and the frontend then calls
# GET /api/stripe/checkout-sessions/{session_id} to know whether the payment/provisioning finished.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# Super Admin (seeder) credentials - change immediately after first login
SUPER_ADMIN_PASSWORD=Khibrat@2026

# Firebase Cloud Messaging (server). Point this at a local service-account JSON
# that is NOT committed to git. Flutter never receives this file.
FIREBASE_CREDENTIALS=storage/app/firebase/credentials.json
FIREBASE_PROJECT_ID=

# Employee AI Assistant (Google Gemini). Never commit a real key.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Prefer a current model (2.5 is blocked for many new API keys):
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TIMEOUT=30
# Max prior messages sent to Gemini for session context (default 20):
# GEMINI_CHAT_HISTORY_LIMIT=20
